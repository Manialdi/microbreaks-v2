{
    "manifest_version": 3,
    "name": "Microbreaks - Personal",
    "version": "1.0.12",
    "description": "Your personal wellness coach for healthy work habits.",
    "action": {},
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/content/avatar-companion.ts"],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "alarms",
        "notifications",
        "sidePanel",
        "identity"
    ],
    "oauth2": {
        "client_id": "YOUR_EXTENSION_CLIENT_ID",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile"
        ]
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "host_permissions": [
        "https://*.supabase.co/*",
        "https://www.micro-breaks.com/*",
        "https://*.avaturn.dev/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://*.avaturn.dev; connect-src 'self' https://*.avaturn.dev https://*.supabase.co https://www.micro-breaks.com"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "videos/*",
                "assets/*",
                "assets/logo-v2.jpg"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
